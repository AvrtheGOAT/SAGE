MONGO_URI=mongodb+srv://USERNAME:PASSWORD@sage-cluster.oql2wge.mongodb.net/

# --- Privacy ---
# Keeps family members signed in across restarts. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Shared secret the ESP32 and voice assistant send in the X-Device-Key header. Put the same value in voice/.env and the firmware.
DEVICE_KEY=change-me-too

# --- Emergencies ---
# demo = record every escalation step but never text or call anyone (use this for the hackathon)
ESCALATION_MODE=demo
NOTIFY_SECONDARY_AFTER_SECONDS=60
CALL_SERVICES_AFTER_SECONDS=120

# --- Agent37 care agent (family summaries) ---
# Key from agent37.com/dashboard/cloud/api-keys. Then run:  python tools\agent37_setup.py  (fills in the instance id)
AGENT37_API_KEY=
AGENT37_INSTANCE_ID=

# --- Wearable (team firmware) ---
# The band posts to http://<laptop-ip>:<PORT>/readings. Its firmware uses port 5001; either set PORT=5001
# here, or change SERVER_URL in the firmware to :5000.
PORT=5000
# 1 = accept the band's POST /readings without X-Device-Key (until the firmware adds the header)
WEARABLE_KEY_OPTIONAL=1
