# Copy to .env and fill in
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Free-tier Flash model; swap if Google renames/retires it
GEMINI_MODEL=gemini-3.5-flash-lite

# Flask backend running on the laptop (same one the ESP32 posts to)
BACKEND_URL=http://127.0.0.1:5000
DEVICE_ID=sage-home-01
# Same value as DEVICE_KEY in backend/.env
DEVICE_KEY=change-me-too

# Speech-to-text: tiny / base / small. Use small for Hindi (base often mishears it)
WHISPER_MODEL=base
# Leave empty for auto-detect (handles English/Hindi/Hinglish), or force "en" / "hi"
WHISPER_LANGUAGE=

# Reminder schedule: "HH:MM|kind|label" separated by ;   kind = medicine or checkin
REMINDERS=09:00|checkin|morning check-in;09:30|medicine|BP tablet;21:00|medicine|diabetes tablet

# How many times SAGE retries an unanswered reminder before escalating, and the gap between tries
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_SECONDS=120

# Mic timing (seconds). Elderly speakers often pause mid-sentence, so be generous.
LISTEN_WAIT_SECONDS=10
SILENCE_TO_STOP=2.0
MAX_UTTERANCE_SECONDS=30
# After SAGE replies, keep listening this long for a follow-up (0 = press Enter every time)
FOLLOWUP_SECONDS=8
REMINDER_LISTEN_SECONDS=15

# Language of SAGE's fixed phrases (reminders, greetings): en or hi
APP_LANGUAGE=hi
# Voice: elevenlabs = most natural (falls back to edge, then offline)
#        edge = free natural online voices incl. Hindi; offline = Windows voices (English only)
TTS_ENGINE=elevenlabs
# From elevenlabs.io > Developers > API keys
ELEVENLABS_API_KEY=your-elevenlabs-key
# Pick a voice: run  python test_elevenlabs.py  to list voices and hear a sample
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_SPEED=0.9
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural

# --- Microphone ---
# Empty = Windows default mic. Run  python mic_check.py  to list mics and test levels.
MIC_DEVICE=
# Lower = more sensitive. 2.5 quiet room, 3.5-5 noisy hall.
MIC_SENSITIVITY=3.0
